# openGym on Render — environment template.
#
# Add these to the service: Settings → Environment → + Add Environment Variable
# (or "Add from .env" to bulk-import this file). Render injects VITE_* as Docker build
# args too, so those two are picked up when the image is built.

# --- Identity & passkeys -------------------------------------------------------
# MUST be, byte for byte, the hostname/URL you open in the browser, e.g. with an app
# named "opengym" the values below are correct. Change these if you rename the service.
RP_ID=opengym.onrender.com
ORIGIN=https://opengym.onrender.com

# --- Storage ------------------------------------------------------------------
# Path of the persistent disk you attach (Disk → mount path /data). The API keeps all
# user data, the session secret and the VAPID keys here — they survive redeploys.
DATA_DIR=/data

# --- Access -------------------------------------------------------------------
# 0 removes the "Continue without account" entrance entirely.
ALLOW_GUEST=0

# --- Notifications (Web Push) --------------------------------------------------
# A real address; push services reject the built-in mailto:admin@localhost fallback.
VAPID_SUBJECT=mailto:you@example.com

# --- Exercise media ------------------------------------------------------------
# The image/GIF dataset baked into the bundle at build time (the Dockerfile's own
# default points at the same jsDelivr copy — only set these to override it).
VITE_IMG_BASE=https://cdn.jsdelivr.net/gh/hasaneyldrm/exercises-dataset@7455efae41b330c265e7cd4b78dfa848e7ce5ebd/images/
VITE_GIF_BASE=https://cdn.jsdelivr.net/gh/hasaneyldrm/exercises-dataset@7455efae41b330c265e7cd4b78dfa848e7ce5ebd/videos/

# --- Single-owner bootstrap (no shell access needed) --------------------------
# The FIRST account to register becomes admin automatically (user.admin=true), so you
# never have to read /data/db.json. Do this right after the first deploy, while
# registrations are still open:
#   1. keep BOOTSTRAP_ADMIN=1 and open the app to create YOUR profile (passkey)
#   2. add INVITE_ONLY=1 below and Save, rebuild, and deploy
#   3. from the app, Admin → Generate invite code (#/admin) for anyone else
BOOTSTRAP_ADMIN=1
#INVITE_ONLY=1